# Set these as environment variables in PowerShell; no dotenv loader is required.
FACTORY_API_URL=http://127.0.0.1:8000
FACTORY_DB_PATH=runtime/factory.db
# Same strong operator key for FastAPI and Streamlit when using a tunnel.
FACTORY_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
DEMO_WHATSAPP_TO=
# Exact public HTTPS URL configured in Twilio, including /webhooks/whatsapp
TWILIO_WEBHOOK_URL=
